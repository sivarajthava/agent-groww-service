# Deployed (Vercel): read runs from the Railway backend. Both are server-side only (no NEXT_PUBLIC_ prefix).
PULSE_API_URL=
PULSE_API_TOKEN=
# Optional Basic auth in front of the whole site, as "user:password".
WEB_BASIC_AUTH=
# Local dev without the backend: directory holding runs/ (default ../data). Ignored when PULSE_API_URL is set.
PULSE_DATA_DIR=
