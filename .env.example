# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=
# Random secret used to hash review ids. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PULSE_ID_SALT=
# Optional: auth header value for an HTTP Gmail MCP server (referenced by name from config.yaml header_env)
GMAIL_MCP_AUTH=
# `pulse serve` only (Railway): bearer token the web app sends; 16+ random characters
PULSE_API_TOKEN=
# Set to true to let scheduled/triggered runs publish via MCP (default: dry run)
PULSE_PUBLISH=
